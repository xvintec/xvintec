# Contact form email (Zoho SMTP). Copy to .env.local for local development.
SMTP_HOST=smtp.zoho.com
SMTP_PORT=465
SMTP_USER=web@xvintec.com
SMTP_PASS=
# Where contact-form leads are delivered. Comma-separate for several recipients.
CONTACT_TO_EMAIL=
# Bunzy blog API read key (server-side only - never prefix with NEXT_PUBLIC_)
BUNZY_BLOG_API_KEY=
BUNZY_BLOG_API_URL=https://app.bunzy.io
